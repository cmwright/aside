# --- macOS ---
.DS_Store

# --- Node / Worker ---
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
.npm/

# --- Wrangler ---
.wrangler/
worker/.dev.vars
worker/.dev.vars.*
!worker/.dev.vars.example

# --- Xcode ---
# The projects are generated by xcodegen from mac/project.yml and ios/project.yml;
# never commit them.
mac/*.xcodeproj/
mac/*.xcworkspace/
ios/*.xcodeproj/
ios/*.xcworkspace/
# Generated by xcodegen from the `info:` blocks in ios/project.yml
ios/App/Info.plist
ios/Keyboard/Info.plist
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.moved-aside
.swiftpm/
mac/.build/

# Personal signing config (team id, identities); see the .example files next to them
mac/Signing.xcconfig
ios/Signing.xcconfig
