<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required under the Hardened Runtime to record from the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- No App Sandbox: the Accessibility API and global key monitors need it off. -->
</dict>
</plist>
