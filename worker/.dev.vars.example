# Copy to .dev.vars (git-ignored) and fill in. `npx wrangler dev` loads it automatically.
# The minimum useful setup is a single free Groq key: it covers both speech-to-text
# and the cleanup pass.

# Which speech-to-text provider to use: "groq" (default) or "deepgram".
# Also settable as a plain var in wrangler.jsonc.
STT_PROVIDER="groq"

# Groq API key (https://console.groq.com/keys).
# Required for Groq speech-to-text and for the cleanup pass on any provider.
GROQ_API_KEY=""

# Deepgram API key (https://console.deepgram.com). Only needed when STT_PROVIDER="deepgram".
DEEPGRAM_API_KEY=""

# Groq chat model for the cleanup pass. Leave unset for openai/gpt-oss-120b.
# Set to "none" to skip cleanup and return the raw transcript (plus dictionary replacements).
CLEANUP_MODEL="openai/gpt-oss-120b"

# Optional shared secret. When set, callers must send:
#   Authorization: Bearer <BACKEND_TOKEN>
# Leave empty for local development so the Mac app works with no token configured.
BACKEND_TOKEN=""
